<div class="mx-auto flex w-full max-w-sm flex-col gap-6">
  <%= link_to "← 一覧へもどる", category_path(@food.category),
        class: "inline-flex min-h-11 items-center self-start text-emerald-700 underline" %>

  <h1 class="text-center text-xl font-bold text-gray-800"><%= @food.name %></h1>

  <% if @food_tips.present? %>
    <ul class="flex flex-col gap-4">
      <% @food_tips.each do |tip| %>
        <li class="flex items-start gap-3 rounded-lg border border-emerald-700 bg-white p-4">
          <%= image_tag food_tip_icon_path(tip.kind), alt: "", class: "size-8 shrink-0" %>
          <div>
            <p class="text-sm font-bold text-emerald-700"><%= food_tip_label(tip.kind) %></p>
            <p class="text-lg text-gray-800"><%= tip.description %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center text-gray-600">このポイントは、準備中です。</p>
  <% end %>
</div>
