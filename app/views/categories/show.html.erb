<div class="mx-auto flex w-full max-w-sm flex-col gap-6">
  <%= link_to "← トップへもどる", root_path,
        class: "inline-flex min-h-11 items-center self-start text-emerald-700 underline" %>

  <h1 class="text-center text-xl font-bold text-gray-800"><%= @category.name %></h1>

  <% if @foods.present? %>
    <ul class="flex flex-col gap-4">
      <% @foods.each do |food| %>
        <li>
          <%= link_to food.name, food_path(food),
                class: "block rounded-lg bg-emerald-700 px-6 py-5 text-center text-xl font-bold text-white shadow hover:bg-emerald-800 active:bg-emerald-900" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center text-gray-600">このカテゴリの食材は、準備中です。</p>
  <% end %>
</div>
